#include <stdio.h>

int main() {
    int n, i;
    float h, k, A, B, Ua, Ub, L,q;
    float a[10], b[10], c[10], d[10], alpha[10], beta[10], x[10];

    // Input temperature at both ends
    printf("Enter the temperature at ends:\n");
    scanf("%f %f", &Ua, &Ub);

    printf("Enter the temperature of the source:  q in Kw = \n");
    scanf("%f", &q);
    
    // Input thermal conductivity, area, length of rod, and number of nodal points
    printf("Enter Thermal conductivity, Area, Length of rod & No. of nodal points:\n");
    scanf("%f %f %f %d", &k, &A, &L, &n);

    // Calculate step size and parameter B
    h = L / n;
    B = (k * A) / h;

    // Initialize the tridiagonal matrix coefficients
    for (i = 2; i <= n; i++)
        a[i] = -B;  // Lower diagonal elements
    for (i = 1; i < n; i++)
        c[i] = -B;  // Upper diagonal elements
    for (i = 1; i <= n; i++) 
    {
        if (i == 1 || i == n)
            b[i] = 3 * B;  // Main diagonal elements at boundaries
        else
            b[i] = 2 * B;  // Main diagonal elements inside
    }

    // Initialize the right-hand side vector d
    for (i = 2; i < n; i++)
        d[i] = 1000*q*A*h;  // Interior points
    d[1] = 2 * B * Ua + 1000*q*A*h;  // Left boundary
    d[n] = 2 * B * Ub + 1000*q*A*h;  // Right boundary

    // Perform forward elimination to calculate alpha and beta
    alpha[1] = b[1];
    beta[1] = d[1] / b[1];

    for (i = 2; i <= n; i++) 
    {
        alpha[i] = b[i] - (a[i] * c[i - 1] / alpha[i - 1]);
        beta[i] = (d[i] - a[i] * beta[i - 1]) / alpha[i];
    }

    // Perform back substitution to find the solution
    x[n] = beta[n];
    for (i = n - 1; i >= 1; i--)
        x[i] = beta[i] - (c[i] * x[i + 1]) / alpha[i];

    // Print the solution
    printf("\nThe required solution is:\n");
    for (i = 1; i <= n; i++)
        printf("U%d = %.2f\n", i, x[i]);

    return 0;
}
